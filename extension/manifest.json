{
  "manifest_version": 3,
  "name": "Leaf Reader",
  "description": "Read selected text and web articles aloud with private, local Piper voices.",
  "version": "1.1.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Leaf Reader",
    "default_popup": "popup.html"
  }
}
